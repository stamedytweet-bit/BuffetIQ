# Copy this file to .env (which git ignores) and fill in the values locally.
# In Colab, add the same names under Secrets (the key icon) instead.
GEMINI_API_KEY=
# Copy the current free-tier Flash or Flash-Lite model ID from Google AI Studio.
GEMINI_MODEL=

# Presenter passcode for the About page controls (Load, Reset, Jump, clock speed).
# Leave empty on the laptop to keep them open. On the Space, set it as a secret instead.
BUFFETIQ_PASSCODE=

# Hugging Face write token, only for publishing with deploy/push_to_space.py from this laptop
HF_TOKEN=
